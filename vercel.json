{
  "buildCommand": "vite build",
  "outputDirectory": "dist/public",
  "redirects": [
    {
      "source": "/(en|de|lander)/:path*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/(en|de|lander)",
      "destination": "/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "index, follow"
        }
      ]
    }
  ]
}